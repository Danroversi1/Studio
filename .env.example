# Copy to .env.local. Never commit real values.

# Supabase (from `supabase status` locally, or the project's API settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key
# Server only. Used solely to complete/fail uploads after the server verifies the object.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Public origin of this app (used to build dev-storage URLs)
APP_URL=http://localhost:3000

# Storage: "dev-filesystem" (local development only) or "r2"
STORAGE_DRIVER=dev-filesystem
# Must equal the database setting studio.storage_bucket (default "studio-media")
STORAGE_BUCKET=studio-media

# dev-filesystem only. At least 32 random characters, e.g. `openssl rand -base64 48`
DEV_STORAGE_SECRET=
DEV_STORAGE_ROOT=.dev-storage

# r2 only. Keep the bucket private (no public access, no r2.dev URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
